cabal-version: 2.4
name: lantern
version: 0.1.0
synopsis: A small, strict HTTP server in Haskell
license: MIT
license-file: LICENSE
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules: Lantern.Config, Lantern.Transport, Lantern.Files, Lantern.Server, Lantern.Client, Lantern.ACME, Lantern.JSON
  build-depends: base >=4.18 && <5, bytestring, containers, text, network, lantern-http, lantern-tls, async, parsec, directory, filepath, unix, time, mime-types, crypton
  c-sources: cbits/confine.c
  ghc-options: -Wall -Wcompat -O2
  default-language: Haskell2010

executable lantern
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: base, lantern
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2 -Wall -O2
  default-language: Haskell2010

test-suite config
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Config.hs
  build-depends: base, lantern, bytestring, text, containers, QuickCheck
  ghc-options: -Wall -threaded
  default-language: Haskell2010
